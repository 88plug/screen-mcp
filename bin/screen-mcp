#!/usr/bin/env bash
# screen-mcp launcher. Runs the stdio MCP server with a Python that has the deps.
# Prefers a project venv (.venv/venv) created at install time; falls back to system
# python3. ${CLAUDE_PLUGIN_ROOT} is expanded by Claude Code when installed as a plugin;
# the dirname fallback covers `claude --plugin-dir ./screen-mcp` dev runs.
set -euo pipefail
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

PY=""
for cand in "$ROOT/.venv/bin/python" "$ROOT/venv/bin/python"; do
  if [ -x "$cand" ]; then PY="$cand"; break; fi
done
PY="${PY:-$(command -v python3 || true)}"

if [ -z "$PY" ]; then
  echo "screen-mcp: no python3 found. Install Python 3 and the deps in requirements.txt." >&2
  exit 1
fi

# Fail fast with a clear message if the required deps aren't importable.
if ! "$PY" -c "import numpy, PIL" >/dev/null 2>&1; then
  echo "screen-mcp: required Python deps missing (numpy, Pillow). One-time setup:" >&2
  echo "  cd \"$ROOT\" && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  echo "  (plus the system packages in the README: GStreamer>=1.28, PipeWire, PyGObject, xdg-desktop-portal-gnome, wl-clipboard)" >&2
  exit 1
fi

exec "$PY" "$ROOT/server.py"
